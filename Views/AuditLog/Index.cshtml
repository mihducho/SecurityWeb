@using static SAProject.Controllers.AuditLogController
@{
    ViewData["Title"] = "Audit Logs - Quản lý nhật ký hệ thống";
    Layout = "_LayoutAdmin";
}

@model List<AuditLogViewModel>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-clipboard-list me-2"></i>@ViewData["Title"]
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo hành động, user, IP...">
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <button id="refreshBtn" class="btn btn-outline-primary">
                                <i class="fas fa-sync-alt me-1"></i>Làm mới
                            </button>
                        </div>
                    </div>

                    <!-- Thông báo khi không có dữ liệu -->
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>Không có dữ liệu nhật ký hệ thống.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>User ID</th>
                                        <th>User Name</th>
                                        <th>Hành động</th>
                                        <th>Controller</th>
                                        <th>Action</th>
                                        <th>Request Path</th>
                                        <th>IP Address</th>
                                        <th>Thời gian</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model)
                                    {
                                        <tr data-id="@log.Id" class="clickable-row">
                                            <td>@log.Id</td>
                                            <td>@log.UserId</td>
                                            <td>
                                                @if (log.UserName == "N/A")
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                                else
                                                {
                                                    @log.UserName
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var badgeClass = "badge-primary";
                                                    if (log.Action.Contains("Success") || log.Action.Contains("Created"))
                                                    {
                                                        badgeClass = "badge-success";
                                                    }
                                                    else if (log.Action.Contains("Failed") || log.Action.Contains("Error"))
                                                    {
                                                        badgeClass = "badge-danger";
                                                    }
                                                    else if (log.Action.Contains("Login") || log.Action.Contains("Logout"))
                                                    {
                                                        badgeClass = "badge-info";
                                                    }
                                                    else if (log.Action.Contains("Delete"))
                                                    {
                                                        badgeClass = "badge-warning";
                                                    }
                                                }
                                                <span class="badge @badgeClass">@log.Action</span>
                                            </td>
                                            <td>
                                                @if (log.ControllerName == "N/A")
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else
                                                {
                                                    @log.ControllerName
                                                }
                                            </td>
                                            <td>
                                                @if (log.ActionName == "N/A")
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else
                                                {
                                                    @log.ActionName
                                                }
                                            </td>
                                            <td>
                                                @if (log.RequestPath == "N/A")
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else
                                                {
                                                    <code class="text-primary">@log.RequestPath</code>
                                                }
                                            </td>
                                            <td>
                                                @if (log.IpAddress == "N/A")
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else
                                                {
                                                    <span class="text-monospace">@log.IpAddress</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Details", "AuditLog", new { id = log.Id })"
                                                       class="btn btn-outline-info"
                                                       title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang đơn giản -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-muted">
                                    Hiển thị <strong>@Model.Count</strong> bản ghi
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    .table th {
        border-top: none;
        font-weight: 600;
    }

    .badge-success {
        background-color: #28a745;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #000;
    }

    .badge-danger {
        background-color: #dc3545;
    }

    .badge-info {
        background-color: #17a2b8;
    }

    .badge-primary {
        background-color: #007bff;
    }

    .table-hover tbody tr.clickable-row:hover {
        background-color: rgba(0, 123, 255, 0.1) !important;
        cursor: pointer;
    }

    .clickable-row {
        transition: background-color 0.2s ease;
    }
</style>

<script>
    $(document).ready(function () {
        // Tìm kiếm đơn giản
        $('#searchInput').on('keyup', function () {
            var searchText = $(this).val().toLowerCase();
            $('table tbody tr').each(function () {
                var rowText = $(this).text().toLowerCase();
                if (rowText.indexOf(searchText) === -1) {
                    $(this).hide();
                } else {
                    $(this).show();
                }
            });
        });

        // Refresh button
        $('#refreshBtn').on('click', function () {
            location.reload();
        });

        // Export button (có thể implement sau)
        $('#exportBtn').on('click', function () {
            showToast('Tính năng export đang được phát triển', 'info');
        });

        // Click vào row để chuyển đến trang details
        $('.clickable-row').on('click', function (e) {
            // Chỉ chuyển hướng nếu không click vào button
            if (!$(e.target).closest('.btn').length) {
                var id = $(this).data('id');
                window.location.href = '@Url.Action("Details", "AuditLog")/' + id;
            }
        });

        function showToast(message, type) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    });
</script>