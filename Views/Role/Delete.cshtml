@model RoleViewModel
@{
    ViewData["Title"] = "Xóa vai trò";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-circle me-2"></i>Cảnh báo!
                        </h5>
                        <p class="mb-0">Bạn sắp xóa vai trò này. Hành động này không thể hoàn tác!</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">Thông tin vai trò sẽ xóa</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th width="40%">ID:</th>
                                    <td>@Model.RoleId</td>
                                </tr>
                                <tr>
                                    <th>Tên vai trò:</th>
                                    <td>
                                        <span class="badge bg-primary">@Model.RoleName</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">Hậu quả</h5>
                            <div class="alert alert-danger">
                                <i class="fas fa-times-circle me-2"></i>
                                <strong>Lưu ý quan trọng:</strong>
                                <ul class="mt-2 mb-0">
                                    <li>Tất cả người dùng có vai trò này sẽ mất quyền truy cập</li>
                                    <li>Không thể khôi phục vai trò sau khi xóa</li>
                                    <li>Có thể ảnh hưởng đến hoạt động của hệ thống</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.RoleId" />

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        Tôi hiểu hậu quả và muốn xóa vai trò này
                                    </label>
                                </div>

                                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                    <i class="fas fa-trash me-1"></i>Xóa vai trò
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <i class="fas fa-times me-1"></i>Hủy bỏ
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmDelete').addEventListener('change', function() {
            document.getElementById('deleteButton').disabled = !this.checked;
        });
    </script>
}