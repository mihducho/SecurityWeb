@model UserDetailViewModel
@{
    ViewData["Title"] = "Chi tiết tài khoản";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-user me-2"></i>@ViewData["Title"]
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Thông tin tài khoản</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th width="40%">ID:</th>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <th>Tên đăng nhập:</th>
                                    <td>@Model.UserName</td>
                                </tr>
                                <tr>
                                    <th>Email:</th>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <th>Họ và tên:</th>
                                    <td>@(string.IsNullOrEmpty(Model.FullName) ? "N/A" : Model.FullName)</td>
                                </tr>
                                <tr>
                                    <th>Xác thực email:</th>
                                    <td>
                                        @if (Model.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">Đã xác thực</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Chưa xác thực</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Bảo mật & Vai trò</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th width="40%">MFA:</th>
                                    <td>
                                        @if (Model.RequireMfa)
                                        {
                                            <span class="badge bg-success">Bật</span>
                                            @if (Model.MfaEnabledAt.HasValue)
                                            {
                                                <small class="text-muted ms-2">(Kích hoạt: @Model.MfaEnabledAt.Value.ToString("dd/MM/yyyy HH:mm"))</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tắt</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Bắt buộc MFA sau lỗi:</th>
                                    <td>
                                        @if (Model.ForceMfaAfterFailedAttempts)
                                        {
                                            <span class="badge bg-info">Có</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Không</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Đăng nhập thất bại:</th>
                                    <td>
                                        <span class="badge bg-@(Model.FailedLoginCount > 0 ? "warning" : "success")">
                                            @Model.FailedLoginCount lần
                                        </span>
                                        @if (Model.LastFailedLoginDate.HasValue)
                                        {
                                            <small class="text-muted ms-2">(Lần cuối: @Model.LastFailedLoginDate.Value.ToString("dd/MM/yyyy HH:mm"))</small>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Vai trò:</th>
                                    <td>
                                        @foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary me-1">@role</span>
                                        }
                                        @if (!Model.Roles.Any())
                                        {
                                            <span class="text-muted">Chưa có vai trò</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-group">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i>Sửa thông tin
                        </a>
                        <a href="@Url.Action("ManageRoles", new { id = Model.Id })" class="btn btn-warning">
                            <i class="fas fa-user-shield me-1"></i>Phân quyền
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }
</style>