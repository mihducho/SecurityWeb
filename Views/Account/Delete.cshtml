@model UserViewModel
@{
    ViewData["Title"] = "Xóa tài khoản";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-circle me-2"></i>Cảnh báo!
                        </h5>
                        <p class="mb-0">Bạn sắp xóa tài khoản này. Hành động này không thể hoàn tác!</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">Thông tin tài khoản sẽ xóa</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th width="40%">Tên đăng nhập:</th>
                                    <td>@Model.UserName</td>
                                </tr>
                                <tr>
                                    <th>Email:</th>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <th>Họ và tên:</th>
                                    <td>@(string.IsNullOrEmpty(Model.FullName) ? "N/A" : Model.FullName)</td>
                                </tr>
                                <tr>
                                    <th>Vai trò:</th>
                                    <td>
                                        @foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary me-1">@role</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">Thống kê bảo mật</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th width="40%">MFA:</th>
                                    <td>
                                        @if (Model.RequireMfa)
                                        {
                                            <span class="badge bg-success">Bật</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tắt</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Đăng nhập thất bại:</th>
                                    <td>
                                        <span class="badge bg-@(Model.FailedLoginCount > 0 ? "warning" : "success")">
                                            @Model.FailedLoginCount lần
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Xác thực email:</th>
                                    <td>
                                        @if (Model.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">Đã xác thực</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Chưa xác thực</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Lưu ý:</strong> Tất cả dữ liệu liên quan đến tài khoản này sẽ bị xóa vĩnh viễn.
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        Tôi hiểu hậu quả và muốn xóa tài khoản này
                                    </label>
                                </div>

                                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                    <i class="fas fa-trash me-1"></i>Xóa tài khoản
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <i class="fas fa-times me-1"></i>Hủy bỏ
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmDelete').addEventListener('change', function() {
            document.getElementById('deleteButton').disabled = !this.checked;
        });
    </script>
}